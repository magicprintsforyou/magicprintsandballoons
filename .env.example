# ============================================================
# Square In-Page Payments (magicprintsandballoons)
# Get these from https://developer.squareup.com/apps
# ============================================================

# Public (safe for the browser) — used by the embedded card form.
# Find in your Square app dashboard: "Application ID" (sq0idp-...)
NEXT_PUBLIC_SQUARE_APPLICATION_ID=REPLACE_WITH_SQUARE_APPLICATION_ID

# Public (safe for the browser) — the Square location for online orders.
# Find in your Square app dashboard or Locations API: "Location ID" (L...)
NEXT_PUBLIC_SQUARE_LOCATION_ID=REPLACE_WITH_SQUARE_LOCATION_ID

# SERVER-ONLY — never expose to the browser, never commit real values.
# Find in your Square app dashboard: "Production Access Token" (sq0atp-...)
# Use the SANDBOX token while testing.
SQUARE_ACCESS_TOKEN=REPLACE_WITH_SQUARE_ACCESS_TOKEN

# sandbox | production — start with "sandbox" for testing
SQUARE_ENVIRONMENT=sandbox

# Used to build absolute URLs for server-side callbacks (optional)
NEXT_PUBLIC_SITE_URL=https://magicprintsandballoons.vercel.app
